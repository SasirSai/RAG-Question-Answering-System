# LLM Provider: 'gemini', 'anthropic', 'ollama', or leave empty for retrieval-only mode
LLM_PROVIDER=

# API keys and endpoints
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RRF_K=60
RRF_CANDIDATE_DEPTH=50
DEFAULT_TOP_K=5
